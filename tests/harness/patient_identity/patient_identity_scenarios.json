  "scenarios": [
    {
      "use_case_id": "patient_identity_POS_0001",
      "subsystem": "client-registry",
      "requirement_ids": [
        "SPID-FR-001",
        "SPID-FR-002",
        "SPID-FR-003",
        "SPID-FR-004",
        "SPID-FR-006",
        "SPID-FR-014"
      ],
      "scenario_category": "Positive",
      "title": "Create patient with registry-issued SPID",
      "description": "Client Registry creates a patient, issues a 10-digit modulus-11 SPID, stores it as the master identity, and publishes a creation event.",
      "preconditions": [
        "Client Registry is healthy",
        "No duplicate or confused-record candidate blocks the request"
      ],
      "trigger": {
        "api": "POST /registry/patients",
        "body_ref": "input_payload",
        "idempotency_key": "idem-patient_identity_POS_0001"
      },
      "input_payload": {
        "correlation_id": "corr-patient_identity_POS_0001",
        "demographics": {
          "given_name": "Sam",
          "family_name": "Adebayo",
          "date_of_birth": "1981-04-12"
        },
        "external_identifiers": [
          {
            "system": "urn:mrn:example",
            "value": "MRN-12345"
          }
        ]
      },
      "expected_connector_calls": [
        {
          "connector": "client_registry",
          "direction": "inbound",
          "endpoint_or_channel": "/registry/patients",
          "protocol": "REST",
          "expected_status": 201
        },
        {
          "connector": "eventbus",
          "direction": "outbound",
          "endpoint_or_channel": "patient.identity.created",
          "protocol": "EVENT",
          "expected_status": 202
        }
      ],
      "expected_events": [
        {
          "topic": "patient.identity.created",
          "type": "PatientIdentityCreated",
          "payload": {
            "patient_id": "9000000009",
            "identifier_system": "https://fhir.symphonix.health/Id/patient",
            "lifecycle_status": "active",
            "identity_version": 1
          }
        }
      ],
      "expected_outputs": {
        "final_status": "SUCCESS",
        "assertions": [
          {
            "check": "patient_id_modulus_11_valid",
            "expected": true
          },
          {
            "check": "nhs_number_system_not_used_for_internal_id",
            "expected": true
          }
        ]
      },
      "fault_profile": {
        "inject_at": "none",
        "mode": "none",
        "severity": "low",
        "retry_policy": {
          "max_retries": 0,
          "backoff_ms": 0
        }
      },
      "security_profile": {
        "auth": "OIDC_JWT",
        "scopes": [
          "patient.identity:create"
        ],
        "transport": "mTLS",
        "expected_auth_result": "ALLOW"
      },
      "priority": "P0",
      "automation_status": "automated",
      "estimated_duration_seconds": 10,
      "tags": [
        "create",
        "registry",
        "event"
      ]
    },
    {
