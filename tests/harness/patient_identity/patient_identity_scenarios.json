        {
          "connector": "human_approval_queue",
          "direction": "outbound",
          "endpoint_or_channel": "identity-review",
          "protocol": "TASK",
          "expected_status": 202
        }
      ],
      "expected_events": [
        {
          "topic": "patient.identity.confusion_detected",
          "type": "PatientIdentityConfusionDetected",
          "payload": {
            "patient_id": "9000000009",
            "candidate_patient_id": "9000000017",
            "status": "under_review"
          }
        }
      ],
      "expected_outputs": {
        "final_status": "UNDER_REVIEW",
        "assertions": [
          {
            "check": "agent_does_not_merge",
