    {
      "use_case_id": "patient_identity_EDG_0008",
      "subsystem": "reconciliation",
      "requirement_ids": [
        "SPID-FR-007",
        "SPID-FR-009",
        "SPID-FR-011",
        "SPID-FR-016"
      ],
      "scenario_category": "Edge",
      "title": "Closed-loop reconciliation repairs projection drift",
      "description": "A scheduled job compares registry and subscriber projections, detects a stale identity version, and replays missing events.",
      "preconditions": [
        "Shared HealthRecord projection is one identity version behind Client Registry"
      ],
      "trigger": {
        "api": "SCHEDULED patient-identity-reconcile",
        "body_ref": "input_payload",
        "idempotency_key": "idem-patient_identity_EDG_0008"
      },
      "input_payload": {
        "patient_id": "9000000009",
        "registry_identity_version": 4,
        "subscriber_identity_version": 3,
        "subscriber": "shared-health-record"
      },
      "expected_connector_calls": [
        {
          "connector": "client_registry",
          "direction": "outbound",
          "endpoint_or_channel": "/registry/patients/9000000009",
          "protocol": "REST",
          "expected_status": 200
        },
        {
          "connector": "eventbus",
          "direction": "outbound",
          "endpoint_or_channel": "identity.replay",
          "protocol": "EVENT",
          "expected_status": 202
        }
      ],
      "expected_events": [
        {
          "topic": "patient.identity.reconciled",
          "type": "PatientIdentityReconciled",
          "payload": {
            "patient_id": "9000000009",
            "subscriber": "shared-health-record",
            "from_version": 3,
            "to_version": 4
          }
        }
      ],
      "expected_outputs": {
        "final_status": "SUCCESS",
        "assertions": [
          {
            "check": "drift_resolved",
            "expected": true
          }
        ]
      },
      "fault_profile": {
        "inject_at": "subscriber_projection",
        "mode": "stale_version",
        "severity": "medium",
        "retry_policy": {
          "max_retries": 3,
          "backoff_ms": 1000
        }
      },
      "security_profile": {
        "auth": "OIDC_JWT",
        "scopes": [
          "patient.identity:reconcile"
        ],
        "transport": "mTLS",
        "expected_auth_result": "ALLOW"
      },
      "priority": "P1",
      "automation_status": "automated",
      "estimated_duration_seconds": 30,
      "tags": [
        "reconciliation",
        "drift"
      ]
    },
