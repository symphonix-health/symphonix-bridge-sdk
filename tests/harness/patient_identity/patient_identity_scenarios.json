      "requirement_ids": [
        "SPID-FR-006",
        "SPID-FR-007",
        "SPID-FR-009"
      ],
      "scenario_category": "Positive",
      "title": "Creation event upserts Shared HealthRecord projection",
      "description": "Shared HealthRecord consumes patient.identity.created and creates a local patient context keyed by SPID without issuing a local patient identifier.",
      "preconditions": [
        "Client Registry outbox contains patient.identity.created",
