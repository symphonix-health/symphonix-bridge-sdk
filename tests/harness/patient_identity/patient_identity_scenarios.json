      ],
      "trigger": {
        "api": "EVENT patient.identity.created",
        "body_ref": "input_payload",
        "idempotency_key": "idem-patient_identity_POS_0002"
      },
      "input_payload": {
        "patient_id": "9000000009",
        "identifier_system": "https://fhir.symphonix.health/Id/patient",
        "identity_version": 1,
        "lifecycle_status": "active",
        "demographics_hash": "sha256:example"
      },
      "expected_connector_calls": [
        {
          "connector": "shared_health_record",
          "direction": "inbound",
          "endpoint_or_channel": "patient.identity.created",
          "protocol": "EVENT",
          "expected_status": 202
        }
      ],
      "expected_events": [
        {
          "topic": "patient.projection.upserted",
          "type": "PatientProjectionUpserted",
          "payload": {
            "patient_id": "9000000009",
            "projection_owner": "shared-health-record",
            "identity_version": 1
          }
        }
      ],
      "expected_outputs": {
        "final_status": "SUCCESS",
        "assertions": [
          {
            "check": "projection_key_equals_spid",
