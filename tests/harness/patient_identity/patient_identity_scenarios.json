      "scenario_category": "Edge",
      "title": "Confused record enters human approval workflow",
      "description": "Probable confused-record evidence is detected. Agents may recommend resolution, but registry places identities under review until an authorised human approves split, merge, or no-merge.",
      "preconditions": [
        "Two demographic profiles collide against one SPID",
        "Duplicate/confusion detector confidence exceeds threshold"
      ],
      "trigger": {
        "api": "POST /registry/confusion-cases",
        "body_ref": "input_payload",
        "idempotency_key": "idem-patient_identity_EDG_0005"
      },
      "input_payload": {
        "patient_id": "9000000009",
        "candidate_patient_id": "9000000017",
        "evidence": [
          "same external MRN used by two demographics"
        ]
      },
      "expected_connector_calls": [
        {
          "connector": "identity_agent",
          "direction": "outbound",
          "endpoint_or_channel": "recommend-resolution",
          "protocol": "A2A",
          "expected_status": 202
